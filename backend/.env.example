# Optional. If set, the Entity Extraction Agent uses OpenAI for higher-
# accuracy NER instead of the built-in regex/heuristic extractor.
# OPENAI_API_KEY=sk-...

# Optional. Model used for the OpenAI-enhanced extraction path if
# OPENAI_API_KEY is set. Defaults to gpt-4o-mini.
# MERIDIAN_LLM_MODEL=gpt-4o-mini
